# 服务端口
PORT=3000

# 登录密码（与服务二选一：环境变量优先于 data/config.json）
PASSWORD=your_password_here

# JWT 签名密钥；留空会自动生成并写入 data/config.json
JWT_SECRET=your-super-secret-jwt-key-change-this

# 站点名称（可选，覆盖 config.json 的 site_name）
SITE_NAME=WarHutTV

# 配置文件路径（可选，默认 data/config.json）
# WARHUTV_CONFIG=./data/config.json

# 反向代理信任列表（逗号分隔的 IP/CIDR，默认 127.0.0.1,::1）
# TRUSTED_PROXIES=127.0.0.1,::1

# 单个搜索源的超时预算（秒数或 Go 时长，默认 10s）；超时/失败的源直接丢弃
# 且计入进度，避免搜索卡在 "24/27"。范围 0.5s ~ 20s。
# SEARCH_SITE_TIMEOUT=10

# 配置文件热重载的轮询间隔（秒数或 Go 时长，默认 2s，范围 200ms ~ 5m）。
# 编辑 data/config.json 后无需重启；Linux/macOS 也可发 SIGHUP 立即重载。
# 设为 0 / off / false 可关闭轮询（仅保留 SIGHUP）。
# CONFIG_WATCH_INTERVAL=2
